[Unit]
Description=Mineral bookmark API
After=network.target

[Service]
Type=simple
User=OpenClaw
Group=OpenClaw
WorkingDirectory=/home/mineral
ExecStart=/usr/bin/python3 /home/mineral/api.py
Restart=on-failure
RestartSec=3
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/mineral/data

[Install]
WantedBy=multi-user.target
